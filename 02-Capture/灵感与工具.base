filters:
  and:
    - file.ext == "md"
    - file.inFolder("02-Capture/灵感与工具")
formulas:
  url_button: if(note["网址"], link(note["网址"], if(note["来源"] && note["来源"].toString().lower() == "bilibili", icon("tv"), if(note["来源"] && note["来源"].toString().lower() == "youtube", icon("circle-play"), icon("external-link")))), "")
  type_view: if(note["类型"], html("<span class='paper-base-badge capture-type-" + note["类型"].toString().lower().replace("&", "and").replace(" ", "-") + "'>" + escapeHTML(note["类型"].toString()) + "</span>"), "")
  source_view: if(note["来源"], html("<span class='paper-base-badge capture-source-" + note["来源"].toString().lower().replace("&", "and").replace(" ", "-") + "'>" + escapeHTML(note["来源"].toString()) + "</span>"), "")
properties:
  file.name:
    displayName: 条目
  formula.type_view:
    displayName: 类型
  状态:
    displayName: 状态
  formula.source_view:
    displayName: 来源
  formula.url_button:
    displayName: 网址
  发现时间:
    displayName: 发现时间
  tags:
    displayName: 标签
  file.mtime:
    displayName: 更新
views:
  - type: table
    name: 收件箱
    filters:
      or:
        - '!note["状态"]'
        - note["状态"] == "inbox"
    order:
      - file.name
      - formula.type_view
      - formula.source_view
      - formula.url_button
      - tags
      - file.mtime
    sort:
      - property: formula.source_view
        direction: DESC
      - property: formula.type_view
        direction: DESC
    columnSize:
      formula.source_view: 103
      formula.url_button: 71
      note.tags: 325
  - type: table
    name: 工具
    filters:
      and:
        - note["类型"] == "tool"
        - '!note["状态"] || note["状态"] != "archive"'
    order:
      - file.name
      - 状态
      - formula.source_view
      - formula.url_button
      - tags
      - file.mtime
  - type: table
    name: 灵感
    filters:
      and:
        - note["类型"] == "idea"
        - '!note["状态"] || note["状态"] != "archive"'
    order:
      - file.name
      - 状态
      - formula.source_view
      - formula.url_button
      - tags
      - file.mtime
  - type: table
    name: 归档
    filters: note["状态"] == "archive"
    order:
      - file.name
      - formula.type_view
      - formula.source_view
      - formula.url_button
      - tags
      - file.mtime
